# Optional .env in the working directory. Environment variables override this file.
# Select another file with --env-file /path/to/config.env or MCP_ENV_FILE.
GOOGLE_MAPS_API_KEY=your-google-api-key
# api-key (default) or oauth for supported Google endpoints:
GOOGLE_MAPS_AUTH_MODE=api-key
# OAuth: a mounted service-account/WIF/ADC JSON file, or omit for default ADC:
# GOOGLE_APPLICATION_CREDENTIALS=/credentials/service-account.json
# GOOGLE_CLOUD_QUOTA_PROJECT=your-billing-project-id
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_TIMEOUT=30
# GOOGLE_MAPS_ENABLED_TOOLS=maps_geocode,maps_search_places,maps_directions
# Required when HTTP binds outside loopback:
# MCP_HTTP_TOKEN=replace-with-a-long-random-secret
# MCP_HTTP_LISTEN=0.0.0.0:3000
# MCP_HTTP_ALLOWED_HOSTS=maps.example.com,localhost:3000
# MCP_HTTP_ALLOWED_ORIGINS=https://app.example.com:443
# RUST_LOG=warn
# Per-tool attempt budget (includes retries), overall deadline, transient retries:
# GOOGLE_MAPS_MAX_REQUESTS=200
# GOOGLE_MAPS_TOOL_TIMEOUT=120
# GOOGLE_MAPS_MAX_RETRIES=2
# Process-wide authenticated MCP requests/minute; 0 disables:
# MCP_HTTP_RATE_LIMIT=120
# MCP_METRICS_ENABLED=false
# MCP_LOG_FORMAT=json
# Native TLS; cert and key must be supplied together:
# MCP_TLS_CERT=/etc/mcp-gmap/tls/tls.crt
# MCP_TLS_KEY=/etc/mcp-gmap/tls/tls.key
# Optional: require client certificates signed by this CA:
# MCP_TLS_CLIENT_CA=/etc/mcp-gmap/tls/client-ca.pem
